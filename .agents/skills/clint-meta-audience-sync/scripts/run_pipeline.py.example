print(r['name'],'->',r.get('operation_status',{{}}).get('description'),f\\\"{{r.get('approximate_count_lower_bound')}}-{{r.get('approximate_count_upper_bound')}}\\\")"
```

## Gerado pela skill `clint-meta-audience-sync`
"""
    (folder / "README.md").write_text(readme, encoding="utf-8")
    (folder / "resultado.json").write_text(
        json.dumps(
            {
                "timestamp": datetime.now().isoformat(),
                "tag_name": tag_name,
                "tag_id": tag_id,
                "ad_account": ad_account,
                "audience_id": audience_id,
                "audience_name": audience_name,
                "workflow_id": workflow_id,
                "editor_url": editor_url,
                "stats": stats,
                "meta_result": meta_result,
            },
            ensure_ascii=False,
            indent=2,
        ),
        encoding="utf-8",
    )


# ===== Main =====
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--tag", required=True, help="Nome exato da tag no Clint")
    ap.add_argument("--audience-name", required=True,
                    help="Nome da Custom Audience na Meta")
    ap.add_argument("--ad-account", default="${RESOURCE_ID}")
    ap.add_argument("--bm", default="BM01")
    ap.add_argument("--skip-workflow", action="store_true",
                    help="Pula a Fase 2 (só upload inicial + docs)")
    args = ap.parse_args()

    env = load_env()

    print(f"[1/3] Resolvendo tag '{args.tag}' no Clint...")
    tag_id, tag_name = clint_resolve_tag_id(env, args.tag)
    print(f"      tag_id={tag_id}")

    print(f"[1/3] Buscando contatos da tag (paginado)...")
    contacts = clint_fetch_contacts_by_tag(env, tag_id)
    print(f"      {len(contacts):,} contatos brutos")

    seen = set()
    records = []
    stats = Counter()
    stats["total"] = len(contacts)
    for c in contacts:
        n = normalize_contact(c)
        if not n:
            stats["descartado"] += 1
            continue
        k = (n["email"], n["phone"])
        if k in seen:
            stats["duplicata"] += 1
            continue
        seen.add(k)
        records.append(n)
    stats["uploaded"] = len(records)
    print(f"      únicos pra upload: {len(records):,}")

    print(f"[2/3] Criando audience na Meta ({args.bm} {args.ad_account})...")
    desc = (
        f"Auto-sync Clint tag '{args.tag}' "
        f"(id {tag_id}) - {datetime.now().strftime('%d/%m/%Y')}"
    )
    audience_id = meta_create_audience(
        env, args.ad_account, args.bm, args.audience_name, desc,
    )
    print(f"      audience_id={audience_id}")

    print(f"[2/3] Upload {len(records):,} contatos em batches de 10k...")
    meta_result = meta_upload_users(env, args.bm, audience_id, records)
    print(f"      num_received={meta_result.get('num_received')} "
          f"num_invalid_entries={meta_result.get('num_invalid_entries')}")

    workflow_id = ""
    editor_url = ""
    if not args.skip_workflow:
        print(f"[3/3] Duplicando workflow n8n base ({WORKFLOW_BASE_ID})...")
        wf_name = (
            f"[Auto-Sync] Clint Tag → Meta Audience: {args.audience_name}"
        )
        workflow_id, editor_url = n8n_duplicate_workflow(
            env, wf_name, tag_id, tag_name, audience_id, args.audience_name,
        )
        print(f"      workflow ATIVO id={workflow_id}")
        print(f"      {editor_url}")

    folder_name = f"{datetime.now().strftime('%d-%m-%Y')}_publico_{slugify(args.audience_name)[:60]}"
    folder = VAULT_TAREFAS / folder_name
    print(f"[3/3] Salvando docs em {folder.name}/")
    write_vault_docs(
        folder,
        tag_name=tag_name,
        tag_id=tag_id,
        ad_account=args.ad_account,
        audience_id=audience_id,
        audience_name=args.audience_name,
        workflow_id=workflow_id,
        editor_url=editor_url,
        stats=dict(stats),
        meta_result=meta_result,
    )

    print()
    print("=" * 60)
    print("PIPELINE CONCLUIDO")
    print("=" * 60)
    print(f"  Audience: {args.audience_name}")
    print(f"  ID:       {audience_id}")
    print(f"  Tag:      {tag_name} (id {tag_id})")
    print(f"  Upload:   {len(records):,} contatos / Meta recv {meta_result.get('num_received')}")
    if workflow_id:
        print(f"  Workflow: {workflow_id}")
        print(f"  Editor:   {editor_url}")
    print(f"  Vault:    {folder}")


if __name__ == "__main__":
    main()

