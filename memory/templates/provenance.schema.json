{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Template inativo de proveniencia, nao recibo de persistencia",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template",
    "active",
    "record",
    "destinations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "template": {
      "const": true
    },
    "active": {
      "const": false
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "scope",
        "kind",
        "summary",
        "origin",
        "locator",
        "observed_at",
        "confidence",
        "confidence_reason",
        "supersedes",
        "task_id",
        "revision",
        "identity_reason",
        "dedupe_key",
        "content_hash"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/nullable_text"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "decisao",
            "aprendizado",
            "procedimento",
            "incidente",
            "handoff"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "confidence": {
          "const": "pending"
        },
        "confidence_reason": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "$ref": "#/$defs/nullable_text"
        },
        "task_id": {
          "$ref": "#/$defs/nullable_text"
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "identity_reason": {
          "type": "string",
          "minLength": 1
        },
        "dedupe_key": {
          "$ref": "#/$defs/nullable_text"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        }
      }
    },
    "destinations": {
      "type": "array",
      "maxItems": 0,
      "description": "Nenhum destino configurado, escrito ou verificado neste exemplo."
    }
  },
  "$defs": {
    "nullable_text": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
